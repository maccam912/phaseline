; Engine configuration file.
config_version=5

[application]
config/name="Phaseline"
config/description="A ten-lane home-row rhythm arcade with a classical remix soundtrack."
config/version="1.1"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.043, 0.051, 0.055, 1)
config/icon="res://assets/icon.png"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[audio]
driver/output_latency=15

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.043, 0.051, 0.055, 1)
textures/vram_compression/import_etc2_astc=true
